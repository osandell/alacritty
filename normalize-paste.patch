 use crate::term::Term;
 use alacritty_terminal::event::Event;

+// --- BEGIN: Windows paste normalization (CRLF -> LF) ---
+#[cfg(windows)]
+fn normalize_line_endings(mut s: String) -> String {
+    // Fast path: only touch when '\r' is present
+    if s.as_bytes().iter().any(|&b| b == b'\r') {
+        // Replace CRLF first, then any remaining lone CR
+        s = s.replace("\r\n", "\n");
+        if s.as_bytes().iter().any(|&b| b == b'\r') {
+            s = s.replace('\r', "\n");
+        }
+    }
+    s
+}
+

+#[cfg(not(windows))]
+#[inline]
+fn normalize_line_endings(s: String) -> String {
+    s
+}
+// --- END: Windows paste normalization ---
